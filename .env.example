# Seats.io Configuration
# Get these from https://app.seats.io/workspace-settings after signing up

# Your public workspace key (found in workspace settings)
VITE_SEATSIO_WORKSPACE_KEY=

# Region: "eu" | "na" | "sa" | "oc"
VITE_SEATSIO_REGION=eu

# Per-concert event keys (create one event per concert in the seats.io dashboard)
# Leave empty to fall back to the built-in CSS grid seat map
VITE_SEATSIO_EVENT_CONCERT_001=
VITE_SEATSIO_EVENT_CONCERT_002=
VITE_SEATSIO_EVENT_CONCERT_003=
VITE_SEATSIO_EVENT_CONCERT_004=
VITE_SEATSIO_EVENT_CONCERT_005=

# The category key you assigned to JoyPass (front-row) seats in your chart designer
VITE_SEATSIO_JOYPASS_CATEGORY=
